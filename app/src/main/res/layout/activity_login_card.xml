<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- Curved header background -->
    <View
        android:id="@+id/curveHeader"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:background="@drawable/bg_curve_top_shape"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Two-line greeting, now perfectly centered inside the header -->
    <TextView
        android:id="@+id/tvHeaderGreeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bem vindo a\nEMIM"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/curveHeader"
        app:layout_constraintBottom_toBottomOf="@id/curveHeader"
        app:layout_constraintStart_toStartOf="@id/curveHeader"
        app:layout_constraintEnd_toEndOf="@id/curveHeader"/>


    <TextView
        android:id="@+id/tvLoginTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Login"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/curveHeader"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="32dp"/>

    <LinearLayout
        android:id="@+id/llLoginForm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvLoginTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <!-- Username (Utilizador) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Utilizador"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/primary_500"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLoginEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:background="@null"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password (Senha) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Senha"
            android:layout_marginTop="16dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/primary_500"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLoginPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:background="@null"/>
        </com.google.android.material.textfield.TextInputLayout>



        <!-- Login button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Login"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/primary_500"
            android:layout_marginTop="24dp"/>
        <!-- OR separator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divider"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OR"
                android:textColor="@color/gray"
                android:layout_marginHorizontal="8dp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divider"/>
        </LinearLayout>

        <!-- Social login buttons (outlined, slight rounding, with specified icon/text colors) -->
        <LinearLayout
            android:id="@+id/llSocialVertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/btnLogin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Apple (black logo & text) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApple"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Apple"
                android:textAllCaps="false"
                android:textColor="#000000"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="#000000"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_apple"
                app:iconTint="#000000"
                app:iconGravity="textStart"
                app:iconPadding="8dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"/>

            <!-- Facebook (blue logo & text) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFacebook"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Facebook"
                android:textAllCaps="false"
                android:textColor="#1877F2"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="#1877F2"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_facebook"
                app:iconTint="#1877F2"
                app:iconGravity="textStart"
                app:iconPadding="8dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"/>

            <!-- Google (red logo, blue text & border) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogle"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Google"
                android:textAllCaps="false"
                android:textColor="#4285F4"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="#DB4437"
            app:strokeWidth="1dp"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_google"
            app:iconTint="#DB4437"
            app:iconGravity="textStart"
            app:iconPadding="8dp"/>

        </LinearLayout>



    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
