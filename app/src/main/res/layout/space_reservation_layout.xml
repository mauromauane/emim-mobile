<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Title -->
    <TextView
        android:id="@+id/formTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reserva de espaço"
        android:textSize="20sp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Scrollable Form -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginBottom="70dp"
        app:layout_constraintTop_toBottomOf="@id/formTitle"
        app:layout_constraintBottom_toTopOf="@id/buttonContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Nome da publicidade -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="#D3D3D3">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputNome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nome da publicidade"

                        android:inputType="textPersonName" />
                </com.google.android.material.textfield.TextInputLayout>
            </androidx.cardview.widget.CardView>

            <!-- Frequência de pagamento -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="#D3D3D3">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputFrequencia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Frequência de pagamento"
                        android:textStyle="bold"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>
            </androidx.cardview.widget.CardView>

            <!-- Província -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Província" />
            <Spinner
                android:id="@+id/spinnerProvincia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:paddingVertical="12dp" />

            <!-- Cidade -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cidade" />
            <Spinner
                android:id="@+id/spinnerCidade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:paddingVertical="12dp" />

            <!-- Bairro -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bairro" />
            <Spinner
                android:id="@+id/spinnerBairro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:paddingVertical="12dp" />

            <!-- Endereço -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="#D3D3D3">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputEndereco"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Endereço"
                        android:textStyle="bold"
                        android:inputType="textPostalAddress" />
                </com.google.android.material.textfield.TextInputLayout>
            </androidx.cardview.widget.CardView>

            <!-- Coordenadas -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Coordenadas" />
            <EditText
                android:id="@+id/inputLatitude"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Latitude"
                android:inputType="numberDecimal"
                android:layout_marginBottom="8dp" />
            <EditText
                android:id="@+id/inputLongitude"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Longitude"
                android:inputType="numberDecimal"
                android:layout_marginBottom="12dp" />

            <!-- Descrição -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Descrição" />
            <EditText
                android:id="@+id/inputDescricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="4"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:layout_marginBottom="12dp" />

            <!-- Documentos -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tipo de documento" />
            <Spinner
                android:id="@+id/spinnerTipoDocumento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" />
            <EditText
                android:id="@+id/inputDescricaoDocumento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Descrição do documento"
                android:layout_marginBottom="12dp" />
            <EditText
                android:id="@+id/inputFormatoDocumento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Formato (ex: PDF, JPG)"
                android:layout_marginBottom="12dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Buttons -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancelar" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Salvar"
            android:layout_marginStart="16dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
