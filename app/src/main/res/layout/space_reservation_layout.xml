<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clForm"
    android:layout_width="match_parent"
    android:layout_height="match_parent">



    <!-- Indicador de passos -->
    <LinearLayout
        android:id="@+id/stepIndicator"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Passo 1: Detalhes -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/stepIcon1"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_green"
                android:padding="8dp"
                android:src="@drawable/ic_baseline_check_24" />
            <TextView
                android:text="Detalhes"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:textSize="12sp"
                android:textColor="#000"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Passo 2: Documentos -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/stepIcon2"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_gray"
                android:padding="8dp"
                android:src="@drawable/ic_baseline_check_24" />
            <TextView
                android:text="Documentos"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:textSize="12sp"
                android:textColor="#000"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Passo 3: Confirmação -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/stepIcon3"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_gray"
                android:padding="8dp"
                android:src="@drawable/ic_baseline_check_24" />
            <TextView
                android:text="Confirmação"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:textSize="12sp"
                android:textColor="#000"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Passo 4: Pagamento -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/stepIcon4"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_gray"
                android:padding="8dp"
                android:src="@drawable/ic_baseline_check_24" />
            <TextView
                android:text="Pagamento"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:textSize="12sp"
                android:textColor="#000"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Form Steps -->
    <ViewFlipper
        android:id="@+id/formSteps"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/stepIndicator"
        app:layout_constraintBottom_toTopOf="@id/buttonContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- Step 1 - Detalhes (with Endereço deslocado aqui) -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/divider"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Informação básica"
                    android:textColor="@color/gray"
                    android:layout_marginHorizontal="8dp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/divider"/>
            </LinearLayout>
            <!-- Username (Utilizador) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputNome"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Nome do outdoor"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/primary_500"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLoginEmail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:inputType="text"
                    android:background="@null"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Data de Início -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDataInicio"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:hint="Data de início"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/primary_500"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_baseline_calendar_month_24">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputDataInicio"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:inputType="none"
                    android:focusable="false"
                    android:clickable="true"
                    android:background="@null"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Data de Fim -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDataFim"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:hint="Data de fim"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/primary_500"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_baseline_calendar_month_24">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputDataFim"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:inputType="none"
                    android:focusable="false"
                    android:clickable="true"
                    android:background="@null"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>
            </com.google.android.material.textfield.TextInputLayout>


            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="16dp"
                />
            <!-- Frequência de pagamento -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textStyle="bold"
                android:text="Frequência de pagamento" />
            <Spinner
                android:id="@+id/spinnerFrequency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_spinner_outline"
                android:padding="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/divider"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Endereços"
                    android:textColor="@color/gray"
                    android:layout_marginHorizontal="8dp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/divider"/>
            </LinearLayout>
            <!-- Endereço -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEndereco"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Localização"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/primary_500"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                >

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputEndereco"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:inputType="textPostalAddress"
                    android:background="@null"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Latitude -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLatitude"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Latitude"
                android:layout_marginTop="8dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/primary_500"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                >

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputLatitude"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:inputType="numberDecimal"
                    android:background="@null"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Longitude -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLongitude"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Longitude"
                android:layout_marginTop="8dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/primary_500"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputLongitude"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:inputType="numberDecimal"
                    android:background="@null"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>
            </com.google.android.material.textfield.TextInputLayout>


        </LinearLayout>

        <!-- Step 2 - Documentos -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Spinner
                android:id="@+id/spinnerTipoDocumento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <EditText
                android:id="@+id/inputDescricaoDocumento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Descrição do documento" />
            <EditText
                android:id="@+id/inputFormatoDocumento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Formato (ex: PDF, JPG)" />
        </LinearLayout>

        <!-- Step 3 - Confirmação -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Labels resumo -->
                <TextView
                    android:id="@+id/labelNome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nome:" />
                <TextView
                    android:id="@+id/labelEndereco"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Endereço:" />
                <TextView
                    android:id="@+id/labelFrequencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Frequência:" />
                <TextView
                    android:id="@+id/labelLatitude"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Latitude:" />
                <TextView
                    android:id="@+id/labelLongitude"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Longitude:" />
                <TextView
                    android:id="@+id/labelTipoDocumento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tipo de Documento:" />
                <TextView
                    android:id="@+id/labelDescricaoDocumento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Descrição do Documento:" />
                <TextView
                    android:id="@+id/labelFormatoDocumento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Formato do Documento:" />

                <!-- Mapa -->
                <com.google.android.gms.maps.MapView
                    android:id="@+id/mapView"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </ScrollView>

        <!-- Step 4 - Pagamento -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pagamento"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo de pagamento" />
            <Spinner
                android:id="@+id/spinnerPagamentoTipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/inputDetalhesPagamento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Referência de pagamento"/>
        </LinearLayout>

    </ViewFlipper>

    <!-- Botões -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <Button
            android:id="@+id/btnAnterior"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Anterior" />
        <Button
            android:id="@+id/btnProximo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Próximo"
            android:layout_marginStart="16dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
