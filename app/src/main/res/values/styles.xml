<resources>
    <style name="Theme.EmimLogin" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- your brand colors -->
        <item name="colorPrimary">@color/primary_500</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/material_dynamic_secondary0</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- make MaterialButton the default button style -->
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button</item>
        <item name="android:statusBarColor">@color/primary_500</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
    <style name="Theme.Emim.Fullscreen" parent="Theme.Emim">
        <!-- hide status bar via theme -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>


