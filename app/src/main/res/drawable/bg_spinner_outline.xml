<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- transparent fill -->
    <solid android:color="@android:color/transparent"/>

    <!-- 1dp border in your primary color -->
    <stroke
        android:width="1dp"
        android:color="@color/primary_500"/>

    <!-- small corner radius -->
    <corners android:radius="4dp"/>

    <!-- some inset so the dropdown arrow isn’t flush to the edge -->
    <padding
        android:left="8dp"
        android:top="4dp"
        android:right="8dp"
        android:bottom="4dp"/>
</shape>
